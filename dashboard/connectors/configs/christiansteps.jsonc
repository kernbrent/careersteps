{
  "name": "dashboard-connect-christiansteps",
  "main": "../worker.mjs",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "christiansteps.net/dashboard-connect*",
      "zone_name": "christiansteps.net"
    },
    {
      "pattern": "christiansteps.net/api/dashboard-connect/*",
      "zone_name": "christiansteps.net"
    }
  ],
  "vars": {
    "SITE_ID": "christiansteps",
    "SITE_ORIGIN": "https://christiansteps.net",
    "DASHBOARD_ORIGIN": "https://dashboard.careersteps.net",
    "AUTH_KIND": "standard",
    "AUTH_NEXT": "/admin/",
    "AUTH_LOGIN_PATH": "/api/admin/login"
  },
  "account_id": "dd6360191de72c9a8f0b45e1676cec65",
  "services": [
    {
      "binding": "AUTH_BACKEND",
      "service": "christian-steps-admin-api"
    }
  ]
}
