{
  "name": "dashboard-connect-prayer",
  "main": "../worker.mjs",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "prayer.hopesojourns.com/dashboard-connect*",
      "zone_name": "hopesojourns.com"
    },
    {
      "pattern": "prayer.hopesojourns.com/api/dashboard-connect/*",
      "zone_name": "hopesojourns.com"
    }
  ],
  "vars": {
    "SITE_ID": "prayer",
    "SITE_ORIGIN": "https://prayer.hopesojourns.com",
    "DASHBOARD_ORIGIN": "https://dashboard.careersteps.net",
    "AUTH_KIND": "prayer",
    "AUTH_NEXT": "/",
    "AUTH_LOGIN_PATH": "/api/login"
  },
  "account_id": "dd6360191de72c9a8f0b45e1676cec65",
  "services": [
    {
      "binding": "AUTH_BACKEND",
      "service": "hope-sojourns-prayer-production"
    }
  ]
}
