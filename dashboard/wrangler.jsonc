{
  "name": "careersteps-website-dashboard",
  "main": "src/entrypoint.mjs",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "dashboard.careersteps.net",
      "custom_domain": true
    }
  ],
  "vars": {
    "APP_ORIGIN": "https://dashboard.careersteps.net",
    "ADMIN_USERNAME": "admin@careersteps.net",
    "ENVIRONMENT": "production"
  },
  "env": {
    "test": {
      "name": "careersteps-website-dashboard-test",
      "routes": [
        {
          "pattern": "dashboard-test.careersteps.net",
          "custom_domain": true
        }
      ],
      "vars": {
        "APP_ORIGIN": "https://dashboard-test.careersteps.net",
        "ADMIN_USERNAME": "admin@careersteps.net",
        "ENVIRONMENT": "test"
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "DASHBOARD_STORE",
            "class_name": "DashboardStore"
          }
        ]
      }
    }
  },
  "account_id": "dd6360191de72c9a8f0b45e1676cec65",
  "migrations": [
    {
      "tag": "dashboard-v1",
      "new_sqlite_classes": [
        "DashboardStore"
      ]
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "DASHBOARD_STORE",
        "class_name": "DashboardStore"
      }
    ]
  }
}
